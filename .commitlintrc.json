{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "scope-enum": [
      2,
      "always",
      [
        "account",
        "admin",
        "auth",
        "brand",
        "cart",
        "catalog",
        "checkout",
        "ci",
        "db",
        "deps",
        "edge",
        "lib",
        "notifications",
        "orders",
        "pwa",
        "shipping",
        "tooling",
        "ui"
      ]
    ],
    "scope-case": [2, "always", "lower-case"],
    "header-max-length": [2, "always", 100]
  }
}
