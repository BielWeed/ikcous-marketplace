VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
# Pagamento online (Fase 2 do CHECKOUT-010). Falha fechada: só "true" liga.
# Em produção fica DESLIGADA até a Fase 3 existir — sem o webhook, pedido pago
# expira em 30 min.
VITE_PAGAMENTO_ONLINE=false
# Chave PUBLICA do Mercado Pago. Vai para o bundle de propósito: é o que o
# Brick usa para tokenizar cartão no navegador. Na Fase 2, sempre a de TESTE,
# pegue-a na aba "Credenciais de teste" do painel do MP — o prefixo NÃO indica
# ambiente (nenhum formato de credencial garante isso na Orders API; ver
# DEPLOYMENT.md §5.1). O ACCESS TOKEN nunca mora aqui — ele é segredo da edge
# function.
VITE_MP_PUBLIC_KEY=YOUR_MP_PUBLIC_KEY_HERE
# Identidade da loja no build (todas opcionais): sem a env, vale o
# src/config/branding.json. Nome vai para manifest, título e meta OG;
# cidade/UF fecham o título da aba ("... | Cidade, UF").
VITE_APP_NAME=IKCOUS - imports
# Cores em hex — SEMPRE entre aspas, senão o # vira comentário.
VITE_BRAND_PRIMARY="#18181B"
VITE_BRAND_SECONDARY="#059669"
VITE_BRAND_ACCENT="#F4F4F5"
VITE_STORE_CITY=Monte Carmelo
VITE_STORE_STATE=MG
# URL pública do site (cards OG/Twitter no build).
VITE_APP_URL=https://ickous-marketplace.vercel.app
