+      ),
+      o.total,
+      o.subtotal,
+      o.discount || 0,
+      o.shipping || 0,
+      o.status || "delivered",
+      o.canal || "online",
+      o.paymentMethod,
+      o.paymentStatus,
+      o.paidAt || null,
+      o.recebidoEm || null,
