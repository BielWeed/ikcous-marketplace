    "eslint": {
      "brace-expansion": "^1.1.13",
      "ajv": "^6.15.0"
    },
    "@eslint/eslintrc": {
      "ajv": "^6.15.0"
    },
    "ajv": "^8.20.0",
    "qs": "^6.15.2"
