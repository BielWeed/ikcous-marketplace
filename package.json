{
  "name": "my-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npx tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "icons": "node scripts/generate-app-icons.mjs",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "sqlfluff:lint": "sqlfluff lint supabase --dialect postgres",
    "lint:css": "stylelint \"src/**/*.css\"",
    "spellcheck": "cspell \"**/*\" --dot --gitignore",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https",
    "lint:html": "htmlhint \"**/*.html\" --ignore \"node_modules/**,dist/**,public/google*.html\"",
    "size": "size-limit",
    "preview": "vite preview"
  },
  "dependencies": {
